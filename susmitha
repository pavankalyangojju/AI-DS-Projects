#include <Wire.h>
#include <Adafruit_GFX.h>
#include <Adafruit_SSD1306.h>
#include <DHT.h>

// ================= OLED =================
#define SCREEN_WIDTH 128
#define SCREEN_HEIGHT 64

#define OLED_SDA 21
#define OLED_SCL 22

Adafruit_SSD1306 display(SCREEN_WIDTH, SCREEN_HEIGHT, &Wire, -1);

// ================= SOIL SENSOR =================
#define SOIL_PIN 34

// ================= DHT11 =================
#define DHT_PIN 4
#define DHT_TYPE DHT11

DHT dht(DHT_PIN, DHT_TYPE);

// ================= RELAY =================
#define RELAY_PIN 26

// Relay logic
// Most relay modules are ACTIVE LOW
#define RELAY_ON  HIGH
#define RELAY_OFF LOW

// ================= SOIL THRESHOLD =================
// Adjust this value according to your sensor
#define DRY_THRESHOLD 3

void setup() {
  Serial.begin(115200);

  // Relay
  pinMode(RELAY_PIN, OUTPUT);
  digitalWrite(RELAY_PIN, RELAY_OFF);

  // DHT
  dht.begin();

  // OLED
  Wire.begin(OLED_SDA, OLED_SCL);

  if (!display.begin(SSD1306_SWITCHCAPVCC, 0x3C)) {
    Serial.println("OLED not found!");
    while (1);
  }

  display.clearDisplay();
  display.setTextColor(SSD1306_WHITE);

  display.setTextSize(2);
  display.setCursor(10, 20);
  display.println("SMART");
  display.setCursor(5, 42);
  display.println("IRRIGATION");
  display.display();

  delay(2000);
}

void loop() {

  // ================= READ SOIL =================
  int soilRaw = analogRead(SOIL_PIN);

  // Convert raw value to percentage
  // Change these values after testing your sensor
  int soilPercent = map(soilRaw, 4095, 1500, 0, 100);

  soilPercent = constrain(soilPercent, 0, 100);

  // ================= READ DHT11 =================
  float temperature = dht.readTemperature();
  float humidity = dht.readHumidity();

  // ================= PUMP CONTROL =================
  bool pumpStatus;

  if (soilPercent < DRY_THRESHOLD) {
    digitalWrite(RELAY_PIN, RELAY_ON);
    pumpStatus = true;
  }
  else {
    digitalWrite(RELAY_PIN, RELAY_OFF);
    pumpStatus = false;
  }

  // ================= SERIAL MONITOR =================
  Serial.println("-----------------------------");

  Serial.print("Soil Moisture: ");
  Serial.print(soilPercent);
  Serial.println("%");

  Serial.print("Temperature: ");
  Serial.print(temperature);
  Serial.println(" C");

  Serial.print("Humidity: ");
  Serial.print(humidity);
  Serial.println("%");

  Serial.print("Pump: ");

  if (pumpStatus) {
    Serial.println("ON");
  } else {
    Serial.println("OFF");
  }

  // ================= OLED DISPLAY =================
  display.clearDisplay();

  display.setTextSize(1);

  display.setCursor(0, 0);
  display.println("SMART IRRIGATION");

  display.drawLine(0, 10, 127, 10, SSD1306_WHITE);

  display.setCursor(0, 16);
  display.print("Soil: ");
  display.print(soilPercent);
  display.println("%");

  display.setCursor(0, 28);
  display.print("Temp: ");

  if (isnan(temperature)) {
    display.println("Error");
  } else {
    display.print(temperature);
    display.println(" C");
  }

  display.setCursor(0, 40);
  display.print("Humidity: ");

  if (isnan(humidity)) {
    display.println("Error");
  } else {
    display.print(humidity);
    display.println("%");
  }

  display.setCursor(0, 53);
  display.print("Pump: ");

  if (pumpStatus) {
    display.println("ON");
  } else {
    display.println("OFF");
  }

  display.display();

  delay(2000);
}
